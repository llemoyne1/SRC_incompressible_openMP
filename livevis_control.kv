# 0344/topo persistent live visualization controls.
# Default location is repository root: livevis_control.kv.
# Edit this file while running; the runner no longer overwrites it unless
# LIVE_VIS_CONTROL_RESET=1 or the file does not exist.
# Supported topo fields: chi, alpha, darcy_power, ux, uy, speed, vorticity, mass, N/count.
field = N
clip = -2
gain = 1
smoothPasses = 0
colormap = thermal
# For N/count, prefer smoothPasses = 0 when checking empty or overpopulated cells.
# Quiver overlay: quiverScale < 0 disables it.  Positive quiverScale is pixels per velocity unit.
quiverNx = 100
quiverNy = 50
quiverScale = 150
quiverMinSpeed = -1
# quiverSmoothPasses < 0 reuses smoothPasses; set e.g. 2 to smooth vectors while keeping field smoothing unchanged.
quiverSmoothPasses = 5