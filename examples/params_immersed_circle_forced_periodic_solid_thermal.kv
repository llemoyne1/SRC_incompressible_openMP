# Qualitative wake/shear smoke test around a fixed analytic circle.
# This is not a final von Karman validation; it is only meant to exercise
# immersed solid reflection + solid_thermal coupling under weak forcing.

inputState = initial_state_circle.smpcd
outputDir = runs/immersed_circle_forced_periodic_solid_thermal

Lx = 1.0
Ly = 1.0
Nx = 32
Ny = 32

dt = 0.001
nSteps = 20000

rotationAngle = 2.0943951023931953
randomRotationSign = true
gridShiftEnable = true
rngSeed = 12345

bcLeft = periodic
bcRight = periodic
bcBottom = periodic
bcTop = periodic

bodyAccelerationX = 0.001
bodyAccelerationY = 0.0

immersedCircleEnable = true
immersedCircleCx = 0.5
immersedCircleCy = 0.5
immersedCircleR = 0.12
immersedCircleFractionSamples = 4
immersedCircleWallUx = 0.0
immersedCircleWallUy = 0.0

wallAccommodation = 1.0
wallVpGamma = 0.0
wallVpMass = 1.0
wallKBT = -1.0
wallThermalNoise = 1.0

thermostatEnable = true
thermostatMode = cell_relative_rescale
thermostatEvery = 1
thermostatTargetKBT = -1.0
thermostatMinParticles = 3
kBT = 0.01

summaryEvery = 100
dumpStateEvery = 1000
numThreads = 4
