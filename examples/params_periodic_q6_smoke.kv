# Minimal periodic SRC/MPCD + Q6 velocity-projection smoke run.
# Validation scope for this first adapter: fully periodic fixed box.
# The runtime does not enforce that scope; use the documented setup deliberately.

inputState = initial_state_q6_32x32_g20.smpcd
outputDir = runs/periodic_q6_smoke

Lx = 1.0
Ly = 1.0
Nx = 32
Ny = 32

dt = 0.001
nSteps = 1000

rotationAngle = 2.0943951023931953
randomRotationSign = true

gridShiftEnable = true
rngSeed = 12345

bodyAccelerationX = 0.0
bodyAccelerationY = 0.0

bcX = periodic
bcY = periodic

method = q6
projectionOperator = periodic_fv_cg
projectionMaxIterations = 300
projectionTolerance = 1.0e-10
projectionMomentumCorrectionEnable = true

thermostatEnable = true
kBT = 0.01

summaryEvery = 10
dumpStateEvery = 1000
numThreads = 4
