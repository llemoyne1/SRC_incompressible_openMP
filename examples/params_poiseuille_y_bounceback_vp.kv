# First Poiseuille-style validation: periodic-x channel, bounceback y-walls
# with aggregate stochastic wall virtual particles.
inputState = initial_state.smpcd
outputDir = runs/poiseuille_y_bounceback_vp

Lx = 1.0
Ly = 1.0
Nx = 32
Ny = 32

dt = 0.001
nSteps = 10000

rotationAngle = 2.0943951023931953
randomRotationSign = true

gridShiftEnable = true
rngSeed = 12345

bodyAccelerationX = 0.005
bodyAccelerationY = 0.0

bcX = periodic
bcY = bounceback

wallVpEnable = true
wallVpMode = stochastic_fraction
wallVpGamma = 0.0      # 0 => infer mean real occupancy Np/(Nx*Ny)
wallVpMass = 1.0
wallVpKBT = -1.0       # negative => inherit kBT
wallVpUxBottom = 0.0
wallVpUyBottom = 0.0
wallVpUxTop = 0.0
wallVpUyTop = 0.0

thermostatEnable = false
kBT = 0.01

summaryEvery = 50
dumpStateEvery = 250
numThreads = 0
