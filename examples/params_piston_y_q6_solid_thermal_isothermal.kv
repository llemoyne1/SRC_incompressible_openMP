# Moving active-domain piston with Q6 projection.
# The active top wall moves downward while the numerical box remains fixed.
# This run validates the moving-wall/active-domain plumbing before virial/EOS closure.
inputState = initial_state_active_y095.smpcd
outputDir = runs/piston_y_q6_solid_thermal_isothermal

Lx = 1.0
Ly = 1.0
Nx = 32
Ny = 32

fluidYTop0 = 0.95
fluidYTopVelocity = -0.001

dt = 0.001
nSteps = 50000

rotationAngle = 2.0943951023931953
randomRotationSign = true

gridShiftEnable = true
rngSeed = 12345

bodyAccelerationX = 0.0
bodyAccelerationY = 0.0

bcLeft = periodic
bcRight = periodic
bcBottom = solid
bcTop = solid

wallAccommodation = 1.0
wallVpGamma = 0.0
wallVpMass = 1.0
wallKBT = -1.0
wallThermalNoise = 1.0
wallUxBottom = 0.0
wallUyBottom = 0.0
wallUxTop = 0.0
wallUyTop = 0.0

method = q6
projectionOperator = channel_fv_cg
projectionMaxIterations = 300
projectionTolerance = 1.0e-10
projectionMomentumCorrectionEnable = true

thermostatEnable = true
thermostatMode = cell_relative_rescale
thermostatEvery = 1
thermostatTargetKBT = -1.0
thermostatMinParticles = 3
kBT = 0.01

summaryEvery = 500
dumpStateEvery = 5000
numThreads = 4
