# Classic SRC/MPCD longer validation case for an analytic rectangular immersed solid.
#
# This is still not the final inlet/outlet backward-facing-step benchmark. It is
# a periodic-x forced channel with a bottom-attached rectangular immersed solid.
# The goal is to quantify the separated/reversed-flow region behind the vertical
# face of the block before extending inlet/outlet and masked Q6/Q9 projection.
#
# Generate the initial state from repository root with:
#   cd matlab
#   generate_backward_step_state('output','../initial_state_backward_step_96x48_g20.smpcd');
#   cd ..

inputState = initial_state_backward_step_96x48_g20.smpcd
outputDir = runs/backward_step_classic_long_96x48

Lx = 2.0
Ly = 1.0
Nx = 96
Ny = 48

fluidXMin0 = 0.0
fluidXMax0 = -1.0
fluidYMin0 = 0.0
fluidYMax0 = -1.0

dt = 0.001
nSteps = 20000

rotationAngle = 2.0943951023931953
randomRotationSign = true
gridShiftEnable = true
rngSeed = 12345

bcLeft = periodic
bcRight = periodic
bcBottom = solid
bcTop = solid

bodyAccelerationX = 0.003
bodyAccelerationY = 0.0

method = classic
projectionEnable = false
q9MassFluxProjectionEnable = false
virialDiagnosticsEnable = false
virialKickEnable = false

immersedSolidEnable = true
immersedSolidShape = rectangle
immersedSolidXMin = 0.25
immersedSolidXMax = 0.65
immersedSolidYMin = 0.0
immersedSolidYMax = 0.50
immersedSolidFractionSamples = 4
immersedSolidVx = 0.0
immersedSolidVy = 0.0
immersedSolidWallUx = 0.0
immersedSolidWallUy = 0.0
immersedSolidOmega = 0.0

wallAccommodation = 1.0
wallVpGamma = 0.0
wallVpMass = 1.0
wallKBT = -1.0
wallThermalNoise = 1.0

thermostatEnable = true
thermostatMode = cell_relative_rescale
thermostatEvery = 1
thermostatTargetKBT = -1.0
thermostatMinParticles = 3
kBT = 0.01

summaryEvery = 100
dumpStateEvery = 1000
numThreads = 4
