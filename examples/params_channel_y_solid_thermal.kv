# Periodic-x channel with generic solid thermal y-walls.
# Recommended solid-wall model: specular impermeability + aggregate thermal wall coupling.
inputState = initial_state.smpcd
outputDir = runs/channel_y_solid_thermal

Lx = 1.0
Ly = 1.0
Nx = 32
Ny = 32

dt = 0.001
nSteps = 1000

rotationAngle = 2.0943951023931953
randomRotationSign = true

gridShiftEnable = true
rngSeed = 12345

bodyAccelerationX = 0.0
bodyAccelerationY = 0.0

bcLeft = periodic
bcRight = periodic
bcBottom = solid
bcTop = solid

wallAccommodation = 1.0
wallVpGamma = 0.0      # 0 => infer mean real occupancy Np/(Nx*Ny)
wallVpMass = 1.0
wallKBT = -1.0         # negative => inherit kBT
wallThermalNoise = 1.0
wallUxBottom = 0.0
wallUyBottom = 0.0
wallUxTop = 0.0
wallUyTop = 0.0

thermostatEnable = false
kBT = 0.01

summaryEvery = 10
dumpStateEvery = 1000
numThreads = 4
