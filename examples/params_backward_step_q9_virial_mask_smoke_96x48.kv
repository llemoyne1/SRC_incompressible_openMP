# Q9+virial smoke case for the immersed-solid face/cell mask.
# Purpose: fast runtime check of virial kick clipping at immersed solid faces.
# This is not a physical validation run.

inputState = initial_state_backward_step_96x48_g20.smpcd
outputDir = runs/backward_step_q9_virial_mask_smoke_96x48

Lx = 2.0
Ly = 1.0
Nx = 96
Ny = 48

fluidXMin0 = 0.0
fluidXMax0 = -1.0
fluidYMin0 = 0.0
fluidYMax0 = -1.0

dt = 0.001
nSteps = 100

rotationAngle = 2.0943951023931953
randomRotationSign = true
gridShiftEnable = true
rngSeed = 12345

bcLeft = periodic
bcRight = periodic
bcBottom = solid
bcTop = solid

bodyAccelerationX = 0.003
bodyAccelerationY = 0.0

method = q9_virial
projectionEnable = true
projectionOperator = channel_fv_cg
projectionMaxIterations = 700
projectionTolerance = 1.0e-10
projectionMomentumCorrectionEnable = true
projectionImmersedSolidMaskEnable = true
projectionImmersedSolidCloseCutFaces = true
projectionImmersedSolidFluidFractionThreshold = 0.5

q9MassFluxProjectionEnable = true
q9MassFluxProjectionStrength = 1.0
q9DensityRelaxationBeta = 0.0005
q9TargetFilter = elliptic_lowpass
q9LowKMaxIndex = 2
q9EllipticLowPassPasses = 1
q9MomentumCorrectionEnable = true
q9ImmersedSolidHaloCells = 0

# Keep Q9 diagnostics visible but cheap.
q9DiagnosticFieldDumpEnable = true
q9DiagnosticFieldDumpEvery = 0
q9DiagnosticFieldDumpFormat = binary

# Deliberately weak virial kick: enough to exercise diagnostics without turning
# the smoke run into a long physical calibration.
virialDiagnosticsEnable = true
virialKickEnable = true
Kvirial = 1.0
virialBeta = 0.05
virialMomentumCorrectionEnable = true
virialOpenBoundaryExclusionCells = 0

immersedSolidEnable = true
immersedSolidShape = rectangle
immersedSolidXMin = 0.25
immersedSolidXMax = 0.65
immersedSolidYMin = 0.0
immersedSolidYMax = 0.50
immersedSolidFractionSamples = 4
immersedSolidVx = 0.0
immersedSolidVy = 0.0
immersedSolidWallUx = 0.0
immersedSolidWallUy = 0.0
immersedSolidOmega = 0.0

wallAccommodation = 1.0
wallVpGamma = 0.0
wallVpMass = 1.0
wallKBT = -1.0
wallThermalNoise = 1.0

thermostatEnable = true
thermostatMode = cell_relative_rescale
thermostatEvery = 1
thermostatTargetKBT = -1.0
thermostatMinParticles = 3
kBT = 0.01

summaryEvery = 25
dumpStateEvery = 25
numThreads = 4
