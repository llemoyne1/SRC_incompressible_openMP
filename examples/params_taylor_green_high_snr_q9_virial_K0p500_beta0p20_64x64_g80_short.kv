# High-SNR short Taylor--Green validation run using filtered Q9 + optional virial EOS kick.
# Validation scope: fully periodic fixed box.
# Generate initial_state_tg_64x64_g80_u0p08_kbt0p01.smpcd with
# matlab/generate_taylor_green_high_snr_short_state.m.

inputState = initial_state_tg_64x64_g80_u0p08_kbt0p01.smpcd
outputDir = runs/taylor_green_high_snr_q9_virial_K0p500_beta0p20_64x64_g80_short

Lx = 1.0
Ly = 1.0
Nx = 64
Ny = 64

dt = 0.001
nSteps = 500

rotationAngle = 2.0943951023931953
randomRotationSign = true

gridShiftEnable = true
rngSeed = 12345

bodyAccelerationX = 0.0
bodyAccelerationY = 0.0

bcX = periodic
bcY = periodic

method = q9_virial
projectionOperator = periodic_fv_cg
projectionMaxIterations = 300
projectionTolerance = 1.0e-10
projectionMomentumCorrectionEnable = true

q9MassFluxProjectionEnable = true
q9MassFluxProjectionStrength = 1.0
q9DensityRelaxationBeta = 0.0005
q9TargetFilter = elliptic_lowpass
q9LowKMaxIndex = 2
q9EllipticLowPassPasses = 1
q9MomentumCorrectionEnable = true

virialDiagnosticsEnable = true
virialKickEnable = true
Kvirial = 0.50
virialBeta = 0.20
virialRhoEOSRefMode = initial_physical_density
virialRhoUniformMode = reference_gamma_current_volume
virialDriveTargetMode = current_uniform
virialRhoKickMode = uniform_now
virialRhoKickMinFraction = 0.1
virialMomentumCorrectionEnable = true

thermostatEnable = true
thermostatMode = cell_relative_rescale
thermostatEvery = 1
thermostatTargetKBT = -1.0
thermostatMinParticles = 3
kBT = 0.01

summaryEvery = 5
dumpStateEvery = 25
numThreads = 4
