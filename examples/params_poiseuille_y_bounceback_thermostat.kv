# First Poiseuille-style validation: periodic-x channel, bounceback y-walls with mass-aware relative thermostat.
# Bounceback gives a simple no-slip-like reference before virtual particles.
inputState = initial_state.smpcd
outputDir = runs/poiseuille_y_bounceback_thermostat

Lx = 1.0
Ly = 1.0
Nx = 32
Ny = 32

dt = 0.001
nSteps = 10000

rotationAngle = 2.0943951023931953
randomRotationSign = true

gridShiftEnable = true
rngSeed = 12345

bodyAccelerationX = 0.005
bodyAccelerationY = 0.0

bcX = periodic
bcY = bounceback

wallVpEnable = false

thermostatEnable = true
thermostatMode = cell_relative_rescale
thermostatEvery = 1
thermostatTargetKBT = -1.0  # negative => inherit kBT
thermostatMinParticles = 3
kBT = 0.01

summaryEvery = 50
dumpStateEvery = 250
numThreads = 4
