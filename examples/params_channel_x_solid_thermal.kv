# Periodic-y channel with generic solid thermal x-walls.
inputState = initial_state.smpcd
outputDir = runs/channel_x_solid_thermal

Lx = 1.0
Ly = 1.0
Nx = 32
Ny = 32

dt = 0.001
nSteps = 1000

rotationAngle = 2.0943951023931953
randomRotationSign = true

gridShiftEnable = true
rngSeed = 12345

bodyAccelerationX = 0.0
bodyAccelerationY = 0.0

bcLeft = solid
bcRight = solid
bcBottom = periodic
bcTop = periodic

wallAccommodation = 1.0
wallVpGamma = 0.0
wallVpMass = 1.0
wallKBT = -1.0
wallThermalNoise = 1.0
wallUxLeft = 0.0
wallUyLeft = 0.0
wallUxRight = 0.0
wallUyRight = 0.0

thermostatEnable = false
kBT = 0.01

summaryEvery = 10
dumpStateEvery = 1000
numThreads = 4
