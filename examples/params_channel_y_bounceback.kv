# Periodic-x channel with simple full-velocity bounceback y-walls. No virtual particles yet.
inputState = initial_state.smpcd
outputDir = runs/channel_y_bounceback

Lx = 1.0
Ly = 1.0
Nx = 32
Ny = 32

dt = 0.001
nSteps = 1000

rotationAngle = 2.0943951023931953
randomRotationSign = true

gridShiftEnable = true
rngSeed = 12345

bodyAccelerationX = 0.0
bodyAccelerationY = 0.0

bcX = periodic
bcY = bounceback

thermostatEnable = false
kBT = 0.01

summaryEvery = 10
dumpStateEvery = 1000
numThreads = 0
