# 0104 periodic-cylinder startup visual: Q6 velocity projection with immersed-solid face/cell mask.
# Geometry is a fixed immersed circular solid, i.e. a 2-D cylinder section.
# Purpose: check the generic elliptic projection with periodic BCs and a closed solid mask.

inputState = initial_state_periodic_cylinder_96x48_g20_0102.smpcd
outputDir = runs/periodic_cylinder_q6_startup_visual_96x48_0104

Lx = 2.0
Ly = 1.0
Nx = 96
Ny = 48

fluidXMin0 = 0.0
fluidXMax0 = -1.0
fluidYMin0 = 0.0
fluidYMax0 = -1.0

dt = 0.001
nSteps = 200

rotationAngle = 2.0943951023931953
randomRotationSign = true
gridShiftEnable = true
rngSeed = 12345

bcLeft = periodic
bcRight = periodic
bcBottom = periodic
bcTop = periodic

bodyAccelerationX = 0.001
bodyAccelerationY = 0.0

method = q6
projectionEnable = true
projectionOperator = periodic_fv_cg
projectionMaxIterations = 500
projectionTolerance = 1.0e-10
projectionMomentumCorrectionEnable = true
projectionImmersedSolidMaskEnable = true
projectionImmersedSolidCloseCutFaces = true
projectionImmersedSolidFluidFractionThreshold = 0.5
projectionAllowUnmaskedImmersedSolid = false

q9MassFluxProjectionEnable = false
q9ImmersedSolidHaloCells = 0
q9DiagnosticFieldDumpEnable = false

virialDiagnosticsEnable = false
virialKickEnable = false

immersedSolidEnable = true
immersedSolidShape = circle
immersedSolidCx = 0.5
immersedSolidCy = 0.5
immersedSolidR = 0.12
immersedSolidFractionSamples = 4
immersedSolidVx = 0.0
immersedSolidVy = 0.0
immersedSolidWallUx = 0.0
immersedSolidWallUy = 0.0
immersedSolidOmega = 0.0

wallAccommodation = 1.0
wallVpGamma = 0.0
wallVpMass = 1.0
wallKBT = -1.0
wallThermalNoise = 1.0

thermostatEnable = true
thermostatMode = cell_relative_rescale
thermostatEvery = 1
thermostatTargetKBT = -1.0
thermostatMinParticles = 3
kBT = 0.01

summaryEvery = 10
dumpStateEvery = 10
numThreads = 4
