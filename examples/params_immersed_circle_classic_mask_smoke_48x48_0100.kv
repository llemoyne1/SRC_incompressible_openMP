# 0100 short immersed-circle smoke: classic SRC/MPCD reference.
# Purpose: runtime/geometric check only, not a physical wake validation.
# Generate state with scripts/run_immersed_circle_face_cell_smoke_0100.sh.

inputState = initial_state_immersed_circle_48x48_g20_0100.smpcd
outputDir = runs/immersed_circle_classic_mask_smoke_48x48_0100

Lx = 1.0
Ly = 1.0
Nx = 48
Ny = 48

fluidXMin0 = 0.0
fluidXMax0 = -1.0
fluidYMin0 = 0.0
fluidYMax0 = -1.0

dt = 0.001
nSteps = 150

rotationAngle = 2.0943951023931953
randomRotationSign = true
gridShiftEnable = true
rngSeed = 12345

bcLeft = periodic
bcRight = periodic
bcBottom = periodic
bcTop = periodic

bodyAccelerationX = 0.003
bodyAccelerationY = 0.0

method = classic
projectionEnable = false
q9MassFluxProjectionEnable = false
virialDiagnosticsEnable = false
virialKickEnable = false

immersedSolidEnable = true
immersedSolidShape = circle
immersedSolidCx = 0.5
immersedSolidCy = 0.5
immersedSolidR = 0.12
immersedSolidFractionSamples = 4
immersedSolidVx = 0.0
immersedSolidVy = 0.0
immersedSolidWallUx = 0.0
immersedSolidWallUy = 0.0
immersedSolidOmega = 0.0

wallAccommodation = 1.0
wallVpGamma = 0.0
wallVpMass = 1.0
wallKBT = -1.0
wallThermalNoise = 1.0

thermostatEnable = true
thermostatMode = cell_relative_rescale
thermostatEvery = 1
thermostatTargetKBT = -1.0
thermostatMinParticles = 3
kBT = 0.01

summaryEvery = 25
dumpStateEvery = 25
numThreads = 4
