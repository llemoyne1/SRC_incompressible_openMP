# Periodic-x channel with specular y-walls. No virtual particles yet.
inputState = initial_state.smpcd
outputDir = runs/channel_y_specular

Lx = 1.0
Ly = 1.0
Nx = 32
Ny = 32

dt = 0.001
nSteps = 1000

rotationAngle = 2.0943951023931953
randomRotationSign = true

gridShiftEnable = true
rngSeed = 12345

bodyAccelerationX = 0.0
bodyAccelerationY = 0.0

bcLeft = periodic
bcRight = periodic
bcBottom = specular
bcTop = specular

thermostatEnable = false
kBT = 0.01

summaryEvery = 10
dumpStateEvery = 1000
numThreads = 0
