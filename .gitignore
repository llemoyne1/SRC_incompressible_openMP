Thumbs.db

# Fichiers/répertoires locaux non versionnés
CMakeLists.txt

# Archives / local backups
*.zip

# Windows metadata files sometimes created under WSL/Linux
*:Zone.Identifier
*Zone.Identifier

# Generated SRC/MPCD particle state files
*.smpcd
*.patch

# Raw generated validation/demo artifacts.  Curated lightweight validation
# summaries are kept under dev_history/validated/ and remain versionable.
dev_history/artifacts/

# Timing files produced by /usr/bin/time wrappers.
*.time

# Local/generated Darcy chi fields
/chi/

